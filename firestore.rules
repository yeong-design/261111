rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: {userId} (matches Firebase Auth UID)
// Fields:
//   - uid: string (optional, immutable, must match userId) - User ID
//   - email: string (optional, <= 320 chars) - User email address
//   - displayName: string (optional, <= 100 chars) - User display name
//   - photoURL: string (optional, <= 500 chars) - User avatar URL
//   - createdAt: timestamp | number | string (optional, immutable) - Account creation timestamp
//   - updatedAt: timestamp | number | string (optional) - Profile update timestamp
//
// Subcollection: users/{userId}/words
// Document ID: {wordId} (auto-generated or custom ID)
// Fields:
//   - english: string (required, 1..200 chars) - English vocabulary word or phrase
//   - korean: string (required, 1..300 chars) - Korean meaning/translation
//   - example: string (optional, 0..500 chars) - Example sentence
//   - category: string (optional, 0..100 chars) - Word category or tag
//   - memorized: bool (optional) - Whether the user has memorized the word
//   - createdAt: timestamp | number | string (optional, immutable when present) - Creation time
//   - updatedAt: timestamp | number | string (optional) - Last update time
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the resource scoped to userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged(userId) {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == userId;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        !('uid' in resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate string length (required string field)
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string (if present and non-null, must be string within length)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate optional boolean
    function isValidOptionalBool(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is bool;
    }

    // Validate optional flexible timestamp (timestamp, number, or bounded string)
    function isValidOptionalTime(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is timestamp ||
        request.resource.data[field] is int ||
        request.resource.data[field] is float ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= 100);
    }

    // Ensure createdAt is not modified once set
    function createdAtUnchanged() {
      return !('createdAt' in resource.data) ||
        !('createdAt' in request.resource.data) ||
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    // Validate user profile document
    function isValidUserProfile(userId) {
      return request.resource.data.keys().size() <= 20 &&
        uidUnchanged(userId) &&
        isValidOptionalString('uid', 1, 128) &&
        isValidOptionalString('email', 0, 320) &&
        isValidOptionalString('displayName', 0, 100) &&
        isValidOptionalString('photoURL', 0, 500) &&
        isValidOptionalTime('createdAt') &&
        isValidOptionalTime('updatedAt');
    }

    // Validate vocabulary word document
    function isValidWord(userId) {
      return hasRequiredFields(['english', 'korean']) &&
        request.resource.data.keys().size() <= 20 &&
        uidUnchanged(userId) &&
        validStringLength('english', 1, 200) &&
        validStringLength('korean', 1, 300) &&
        isValidOptionalString('example', 0, 500) &&
        isValidOptionalString('category', 0, 100) &&
        isValidOptionalBool('memorized') &&
        isValidOptionalTime('createdAt') &&
        isValidOptionalTime('updatedAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User profile document
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(userId);
      allow update: if isOwner(userId) && isValidUserProfile(userId) && uidNotModified() && createdAtUnchanged();

      // User's vocabulary words subcollection
      match /words/{wordId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWord(userId);
        allow update: if isOwner(userId) && isValidWord(userId) && uidNotModified() && createdAtUnchanged();
      }
    }

    // Default deny for all other collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
